# Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_saas_db
DATABASE_POOL_SIZE=20

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# OAuth - Google
OAUTH_GOOGLE_ID=your-google-oauth-id.apps.googleusercontent.com
OAUTH_GOOGLE_SECRET=your-google-oauth-secret

# OAuth - GitHub
OAUTH_GITHUB_ID=your-github-oauth-id
OAUTH_GITHUB_SECRET=your-github-oauth-secret

# Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=your-email-service-user
SMTP_PASS=your-email-service-password
SMTP_FROM=noreply@crmsaas.com
SMTP_FROM_NAME=CRM SaaS Platform

# Payment - Stripe
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=crm-saas-bucket

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# API Security
API_RATE_LIMIT=100
API_RATE_WINDOW=15
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# AI/ML
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# Sentry
SENTRY_DSN=

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_CUSTOM_WORKFLOWS=false
